{
  "name": "h6s",
  "private": true,
  "description": "Serve headless component development kit for React production apps",
  "keywords": [
    "headless",
    "react",
    "cdk",
    "calendar",
    "fullcalendar",
    "react-calendar",
    "table",
    "complex-table",
    "merge table",
    "react-table"
  ],
  "author": "JaeYeopHan(Jbee)",
  "organization": "toss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toss/h6s.git"
  },
  "homepage": "https://h6s.dev",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@changesets/cli": "^2.27.7",
    "@mdx-js/react": "2.3.0",
    "@storybook/addons": "7.6.6",
    "@storybook/react": "7.6.6",
    "@storybook/react-vite": "^7.6.4",
    "@storybook/theming": "7.6.6",
    "@types/node": "^22.5.2",
    "@types/react": "^18.3.5",
    "husky": "7.0.4",
    "knip": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^7.6.4",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "knip": "knip --treat-config-hints-as-errors",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "lint": "pnpm --filter '@h6s/*' --recursive run lint",
    "test": "pnpm --filter '@h6s/*' --recursive run test",
    "typecheck": "pnpm --filter '@h6s/*' --recursive run typecheck",
    "build": "pnpm --filter '@h6s/*' --recursive run build",
    "build:storybook": "storybook build",
    "storybook": "storybook dev -p 6006 --quiet",
    "postinstall": "husky install"
  },
  "packageManager": "pnpm@10.34.0"
}
